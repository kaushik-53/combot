# ─── Server ──────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in the values.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/combot

# JWT signing secret — use a long random string (e.g., openssl rand -hex 64)
JWT_SECRET=replace_me_with_a_long_random_secret

# Access token lifetime (do not change — 15m is a security requirement)
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token cookie lifetime in milliseconds (7 days)
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000

# Express port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# CORS — set to your Vite dev server origin in development
CLIENT_ORIGIN=http://localhost:5173

# ─── Seed script ─────────────────────────────────────────────────────────────
# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1!
